{
  "name": "zhuwei-cloudflare-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:unit && npm run test:worker",
    "test:unit": "tsx --test tests/**/*.test.mjs",
    "test:worker": "vitest run",
    "module:check": "tsx scripts/check-modules.mjs",
    "profile:reference-gate": "tsx scripts/check-runtime-profile-references.mts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern src --ignore-pattern server --ignore-pattern scripts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "cf:dev": "wrangler dev",
    "cf:deploy": "node cloudflare/verify-deploy-config.mjs && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.510.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "react-test-renderer": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  }
}
