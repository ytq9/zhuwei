        ],
        "acquisition": "开场亲自在大厅的经历。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:introductions",
      "audience": {
        "kind": "openingPlayers",
        "sceneId": "wake",
        "anyProficientSkills": []
      },
      "kind": "sourceClaim",
      "content": {
        "description": "入门时的守灵介绍称：逝者是店主赫斯·黑橡，莉安是他的女儿，瓦罗是镇公所书记官；奈斯自称赫斯的远房表弟。奈斯的血亲身份只是他的自称，尚未核验。",
        "sourceRefs": [
          "wake",
          "npc:black-oak-will:lian",
          "npc:black-oak-will:varo",
          "npc:black-oak-will:naes"
        ],
        "acquisition": "开场前在大厅听守灵者介绍，奈斯的血亲说法来自奈斯本人；只记录听到的说法。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:documents-training",
      "audience": {
        "kind": "openingPlayers",
        "sceneId": "wake",
        "anyProficientSkills": [
          "investigation",
          "history"
        ]
      },
      "kind": "canonicalFact",
      "content": {
        "description": "你已有的文书辨识训练告诉你：印章可用来比较印模，正文作者、写作时间和条款是否增补仍须另有证据。两份文件可以并排比较，不必把持有真印视为全部内容真实。",
        "sourceRefs": [],
        "acquisition": "角色卡中已有的调查或历史技能训练；没有据此确认本案哪一份真假。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:religion-training",
      "audience": {
        "kind": "openingPlayers",
        "sceneId": "wake",
        "anyProficientSkills": [
          "religion"
        ]
      },
      "kind": "canonicalFact",
      "content": {
        "description": "你已有的宗教知识告诉你：听见与死者相似的声音不足以证明亡魂身份；教团印记、仪式痕迹与当事人证词需要分别核对。你尚未因此认出本案的教派、神龛或死因。",
        "sourceRefs": [],
        "acquisition": "角色卡中已有的宗教技能训练；不新增与本地教团接触的个人经历。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:lian-copper-key",
      "audience": {
        "kind": "npc",
        "entityRef": "npc:black-oak-will:lian"
      },
      "kind": "canonicalFact",
      "content": {
        "description": "父亲留下的铜钥现在由我拿着。它不是后院酒窖门锁的铁钥；父亲要我把它交给能拒绝歌唱的人。交给谁仍由我根据眼前的人和事情判断。",
        "sourceRefs": [
          "item-entry:unique:363f5adf078f8fa56caad568829bb9d5"
        ],
        "acquisition": "赫斯生前交代与本人持续保管。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:lian-will",
      "audience": {
        "kind": "npc",
        "entityRef": "npc:black-oak-will:lian"
      },
      "kind": "sourceClaim",
      "content": {
        "description": "父亲亲口说过还留有第三份遗嘱，但我没有见过原件，也不知道藏处和完整正文。",
        "sourceRefs": [],
        "acquisition": "赫斯生前向莉安的口头交代；没有把未读文书当作本人见过的事实。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:lian-voice",
      "audience": {
        "kind": "npc",
        "entityRef": "npc:black-oak-will:lian"
      },
      "kind": "sensoryEvidence",
      "content": {
        "description": "我在酒窖门外听过像母亲的声音。那声音让我想起她唱的摇篮曲，但我没有见到母亲，也不知道门后的东西是什么。",
        "sourceRefs": [
          "yard"
        ],
        "acquisition": "莉安此前在后院门外亲耳听见；只确认听觉经历。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:varo-custody",
      "audience": {
        "kind": "npc",
        "entityRef": "npc:black-oak-will:varo"
      },
      "kind": "canonicalFact",
      "content": {
        "description": "备案原件和酒窖铁钥现在由我保管。我后加了原件末三行，并让人封了门；这样能把酒窖控制住，等我准备发掘。",
        "sourceRefs": [
          "item-entry:unique:b8c287821ebc046eb3d4af00e132ad5d",
          "item-entry:unique:139ca78750c5f29d9ee46fc340f18b3c"
        ],
        "acquisition": "瓦罗本人实施的改写、封门与保管行为。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:varo-limits",
      "audience": {
        "kind": "npc",
        "entityRef": "npc:black-oak-will:varo"
      },
      "kind": "canonicalFact",
      "content": {
        "description": "我没有读过第三份遗嘱，也没有亲眼见到赫斯如何死亡。地下可能有值得发掘的东西是我的判断，不是我已查明的宝藏或死因。",
        "sourceRefs": [
          "yard"
        ],
        "acquisition": "区分瓦罗的实际经历、猜测与未取得的信息。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:naes-forgery",
      "audience": {
        "kind": "npc",
        "entityRef": "npc:black-oak-will:naes"
      },
      "kind": "canonicalFact",
      "content": {
        "description": "第二份遗嘱是我伪造的。真印被我偷用后藏在衣袋里，文书还由我收着；需要拉拢见证时我可以主动出示，纸张与印章不会自动交到别人手里。",
        "sourceRefs": [
          "item-entry:unique:2b3c1942da9b7be80fe882823ec0425c",
          "item-entry:unique:2acc535c92187b76c0a5d0d5cfb39d7c"
        ],
        "acquisition": "奈斯本人实施的伪造、偷用和保管。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:naes-ritual",
      "audience": {
        "kind": "npc",
        "entityRef": "npc:black-oak-will:naes"
      },
      "kind": "canonicalFact",
      "content": {
        "description": "我知道赫斯许下未唱完摇篮曲的旧誓，也知道怎样应和回声。我听说他留有第三份遗嘱，猜在石座附近，但还没下去查到，不能说出确切夹层位置。",
        "sourceRefs": [],
        "acquisition": "枯骨会内本人取得的旧誓和仪式知识；石座藏处只是猜测。"
      }
    },
    {
      "id": "knowledge:module:black-oak-will:echo-boundary",
      "audience": {
        "kind": "npc",
        "entityRef": "npc:black-oak-will:echo"
      },
      "kind": "canonicalFact",
      "content": {
        "description": "我保留赫斯当年的誓言和摇篮曲末句，以旧嗓音重复呼唤。开场没有听到大厅里的争论，也不知道未向我报过的来客姓名。",
        "sourceRefs": [
          "shrine"
        ],
        "acquisition": "神龛绑定的有限记忆与开场所在位置；不共享其他人的耳目。"
      }
