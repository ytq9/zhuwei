{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhuwei-room-test",
  "main": "tests/room-worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "STORY_ARCHIVE_TEST_DB",
    "database_name": "story-archive-test",
    "database_id": "00000000-0000-0000-0000-000000000013"
  }],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      },
      {
        "name": "VNEXT_ROOMS",
        "class_name": "VNextStage3RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "room-do-v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    },
    {
      "tag": "room-do-vnext-stage3",
      "new_sqlite_classes": ["VNextStage3RoomDurableObject"]
    }
  ]
}
